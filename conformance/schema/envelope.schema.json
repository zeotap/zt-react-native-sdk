{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalsmith.dev/sdk/conformance/envelope.schema.json",
  "title": "SDK conformance vector file",
  "type": "object",
  "required": ["family", "version", "sources", "sourceHash", "generatedBy", "cases"],
  "additionalProperties": false,
  "properties": {
    "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "const": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^sdk/js/src/.+\\.ts$" } },
    "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generatedBy": { "type": "string", "pattern": "^sdk/js/scripts/conformance/.+\\.gen\\.ts$" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["js", "android", "ios", "react-native"] }
          },
          "input": {},
          "expected": {},
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
