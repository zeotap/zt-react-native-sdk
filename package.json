{
  "name": "@zeotap/react-native-sdk",
  "version": "0.1.0",
  "description": "SignalSmith React Native SDK — a thin bridge over the native Android and iOS SDKs",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "app.plugin.js",
    "NATIVE_VERSIONS.json",
    "ZeotapReactNative.podspec",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!android/src/test",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "stamp-version": "node scripts/stamp-version.mjs",
    "check-version": "node scripts/stamp-version.mjs --check",
    "prepare": "bob build",
    "prepack": "npm run stamp-version"
  },
  "keywords": [
    "react-native",
    "analytics",
    "cdp",
    "signalsmith",
    "zeotap"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeotap/zeotap-pulse-rn.git"
  },
  "homepage": "https://github.com/zeotap/zeotap-pulse-rn#readme",
  "bugs": {
    "url": "https://github.com/zeotap/zeotap-pulse-rn/issues"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-builder-bob": "^0.32.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "react-native",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "globals": {
      "ZEOTAP_CONFORMANCE_DIR": "conformance/vectors"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNZeotapSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.zeotap.reactnative"
    }
  }
}
